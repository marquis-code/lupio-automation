          "mode": "raw",
          "raw": "[\n  {\n    \"name\": \"Project ABC\",\n    \"projectType\": \"RFP\",\n    \"companyName\": \"Acme Co\",\n    \"dueDate\": \"2026-09-08T15:39:04Z\",\n    \"description\": \"Some description\"\n  },\n  {\n    \"name\": \"Project XYZ\",\n    \"projectType\": \"RFI\",\n    \"companyName\": \"Beta Inc\",\n    \"dueDate\": \"2026-10-01T12:00:00Z\"\n  }\n]"
        },
